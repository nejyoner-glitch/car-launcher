<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:background="#080E18" android:padding="18dp">
 <!-- NOVA Drive: clean top bar -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="90dp" android:orientation="horizontal" android:gravity="center_vertical">
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
   <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="52sp" android:textStyle="bold" android:includeFontPadding="false"/>
   <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#92A9C4" android:textSize="15sp"/>
  </LinearLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="NOVA  /  CLIO IV" android:textColor="#5CCCF8" android:textStyle="bold" android:textSize="20sp" android:letterSpacing="0.1"/>
  <TextView android:id="@+id/weather" android:layout_width="210dp" android:layout_height="68dp" android:layout_marginStart="20dp" android:background="@drawable/bg_card" android:gravity="center" android:textColor="#E7EFF9" android:textSize="17sp"/>
 </LinearLayout>
 <!-- Two large focus panels -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:orientation="horizontal">
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:layout_marginEnd="12dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="20dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RENAULT CLIO IV" android:textColor="#D9E8F8" android:textStyle="bold" android:textSize="21sp" android:letterSpacing="0.08"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="20 ASZ 083   ·   BEYAZ" android:textColor="#82A0BD" android:textSize="15sp"/>
   <ImageView android:layout_width="match_parent" android:layout_height="118dp" android:layout_marginTop="6dp" android:src="@drawable/clio_silhouette" android:scaleType="fitCenter" android:contentDescription="Beyaz Renault Clio 4 çizimi"/>
   <LinearLayout android:id="@+id/speedCard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ANLIK HIZ" android:textColor="#91A8C2" android:textSize="13sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
     <TextView android:id="@+id/speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#5CD2FF" android:textSize="82sp" android:textStyle="bold" android:includeFontPadding="false"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/kmh" android:textColor="#B6C8DC" android:textSize="18sp"/>
     <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
     <TextView android:id="@+id/heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#E6F1FC" android:textSize="27sp"/>
    </LinearLayout>
    <TextView android:id="@+id/trip" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D0DDEC" android:textSize="16sp" android:maxLines="2"/>
    <TextView android:id="@+id/gpsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/gps_waiting" android:textColor="#8197B0" android:textSize="13sp"/>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal">
    <TextView android:id="@+id/quickCarPlay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_card" android:gravity="center" android:text="CarPlay" android:textColor="#6CD9FF" android:textStyle="bold" android:textSize="19sp"/>
    <TextView android:id="@+id/quickRadio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_card" android:gravity="center" android:text="Radyo" android:textColor="#E8EFF8" android:textStyle="bold" android:textSize="19sp"/>
    <TextView android:id="@+id/quickNav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_card" android:gravity="center" android:text="Araç" android:textColor="#E8EFF8" android:textStyle="bold" android:textSize="19sp"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/mediaCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_card" android:padding="20dp" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MÜZİK" android:textColor="#86A3C1" android:textSize="15sp" android:textStyle="bold" android:letterSpacing="0.08"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/art" android:layout_width="142dp" android:layout_height="142dp" android:src="@drawable/ic_music" android:scaleType="centerCrop" android:contentDescription="Albüm kapağı"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="20dp" android:orientation="vertical">
     <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_media" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
     <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#A6BCD6" android:textSize="17sp" android:maxLines="1" android:ellipsize="end"/>
     <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="18dp" android:max="1000" android:visibility="invisible"/>
    </LinearLayout>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:gravity="center" android:orientation="horizontal">
    <ImageButton android:id="@+id/btnPrev" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_round_btn" android:src="@drawable/ic_prev" android:padding="22dp" android:contentDescription="Önceki"/>
    <ImageButton android:id="@+id/btnPlay" android:layout_width="78dp" android:layout_height="78dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="@drawable/bg_round_btn" android:src="@drawable/ic_play" android:padding="22dp" android:contentDescription="Oynat / Duraklat"/>
    <ImageButton android:id="@+id/btnNext" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_round_btn" android:src="@drawable/ic_next" android:padding="22dp" android:contentDescription="Sonraki"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
 <!-- Single-row favorites -->
 <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="106dp" android:layout_marginTop="12dp" android:orientation="horizontal"/>
 <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" android:orientation="horizontal"/>
 <!-- Bottom command dock -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card" android:paddingStart="8dp" android:paddingEnd="8dp">
  <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Ana" android:textColor="#B5C7DD" android:textSize="15sp"/>
  <TextView android:id="@+id/navCarplay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="CarPlay" android:textColor="#B5C7DD" android:textSize="15sp"/>
  <TextView android:id="@+id/navMedia" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Müzik" android:textColor="#B5C7DD" android:textSize="15sp"/>
  <TextView android:id="@+id/navVehicle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Araç" android:textColor="#B5C7DD" android:textSize="15sp"/>
  <TextView android:id="@+id/navApps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Uygulamalar" android:textColor="#B5C7DD" android:textSize="15sp"/>
  <TextView android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Ayarlar" android:textColor="#B5C7DD" android:textSize="15sp"/>
  <LinearLayout android:id="@+id/btnAllApps" android:layout_width="1dp" android:layout_height="match_parent" android:visibility="gone" android:orientation="horizontal"/>
  <ImageButton android:id="@+id/btnVolDown" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:background="@drawable/bg_round_btn" android:src="@drawable/ic_vol_down" android:padding="17dp" android:contentDescription="Sesi kıs"/>
  <ImageButton android:id="@+id/btnVolUp" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:background="@drawable/bg_round_btn" android:src="@drawable/ic_vol_up" android:padding="17dp" android:contentDescription="Sesi aç"/>
  <ImageButton android:id="@+id/btnMute" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:background="@drawable/bg_round_btn" android:src="@drawable/ic_mute" android:padding="17dp" android:contentDescription="Sessiz"/>
  <ImageButton android:id="@+id/btnVoice" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:src="@drawable/ic_mic" android:contentDescription="Sesli asistan"/>
  <ImageButton android:id="@+id/btnSettings" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:src="@drawable/ic_settings" android:contentDescription="Ayarlar"/>
 </LinearLayout>
</LinearLayout>